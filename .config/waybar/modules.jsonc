{
// Left
"hyprland/workspaces": {
         //"format": "{name}: {icon}",
         //"format-icons": {
         //    "Main": "",
         //    "Left": "",
         //    "Right": ""
	 //}
},

"hyprland/window": {
	"icon": true,
	"tooltip": false,
	"separate-outputs": true
},


// Center
"clock": {
	"tooltip-format": "{:%m-%d-%Y}"
},

"gamemode": {
	"format": "{glyph}",
	"format-alt": "{glyph} {count}",
	"hide-not-running": true
},


// Right
"tray": {
        "icon-size": 20,
        "spacing": 10,
	"icons": {
	   }
},

"custom/hyprpicker": {
	"format": "🎨",
	"tooltip-format": "Hyprpicker",
	"on-click": "hyprpicker | wl-copy",
	"on-click-right": "hyprpicker -f rgb | wl-copy"
},

"custom/media": {
        "format": "{icon}",
	"tooltip-format": "{text}",
	"tooltip": true,
        "return-type": "json",
        "max-length": 60,
        "format-icons": {
            "spotify": "",
	    "firefox": "🦊",
	    "default": "🎜"
        },
        "on-click": "playerctl play-pause",
        "exec": "$HOME/.config/waybar/scripts/mediaplayer-wrapper.sh"
},

"pulseaudio": {
        "scroll-step": 5, // %, can be a float
        "format": "{icon}",
        "format-bluetooth": "icon}",
        "format-bluetooth-muted": " {icon}",
	"format-muted": " ",
	"tooltip-format": "{volume}% {desc}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "on-click": "pkill pavucont || pavucontrol-qt"
},


"custom/power": {
        "format" : "🌩️",
	"tooltip-format": "Power Menu",
	"menu": "on-click",
	"menu-file": "$HOME/.config/waybar/power_menu.xml",
	"menu-actions": {
		"shutdown": "shutdown now",
		"reboot": "reboot",
		"suspend": "systemctl suspend",
		"hibernate": "systemctl hibernate"
	}
},
}

// ETC or WIP
